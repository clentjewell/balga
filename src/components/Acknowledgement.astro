---
import { site } from "../data/site";
---
<section class="ack" aria-label="Acknowledgement of Country">
  <div class="container">
    <p>{site.acknowledgement}</p>
  </div>
</section>
<style>
  .ack { background: var(--color-sand); padding-block: clamp(2.2rem, 1.5rem + 3vw, 3.4rem); }
  .ack p { max-width: 68ch; margin-inline: auto; text-align: center; color: var(--color-secondary-dark); font-size: 0.98rem; line-height: 1.9; }
</style>
