---
import { whyChooseUs } from "../data/content";
import { altFor } from "../data/media";
export interface Props { showIntro?: boolean; }
const { showIntro = true } = Astro.props;

// Pillar icons: certificate · person in view-finder · leaves.
const svg = (paths: string) =>
  `<svg viewBox="0 0 40 40" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const icons = [
  // certificate — Personal Expertise
  svg(`<rect x="3" y="6" width="26" height="20" rx="1.6"/><path d="M8 12h14M8 17h14M8 22h7"/>
       <circle cx="28" cy="25.5" r="5.5"/><path d="M25 30l-1.4 6 4.4-2.4 4.4 2.4L31 30"/>`),
  // person in a view-finder — Dedicated Approach
  svg(`<circle cx="20" cy="20" r="9"/><circle cx="20" cy="17.4" r="2.9"/><path d="M15 25.6a5.4 5.4 0 0 1 10 0"/>
       <path d="M13.4 13.4 8 8M8 12.6V8h4.6M26.6 13.4 32 8M27.4 8H32v4.6M13.4 26.6 8 32M8 27.4V32h4.6M26.6 26.6 32 32M32 27.4V32h-4.6"/>`),
  // leaves — Passion for Sustainability
  svg(`<path d="M20 20C20 10 24 7 33 7C33 16 30 20 20 20z"/><path d="M22 18C25 14.5 28 11.5 31 9.5"/>
       <path d="M20 20C20 30 16 33 7 33C7 24 10 20 20 20z"/><path d="M18 22C15 25.5 12 28.5 9 30.5"/>`),
];
---
<section class="why">
  <div class="why__bg" aria-hidden="true"></div>
  <div class="why__grid">
    <div class="why__media reveal">
      <img src={whyChooseUs.image} alt={altFor(whyChooseUs.image, whyChooseUs.imageAlt)} width="600" height="800" loading="lazy" />
    </div>
    <div class="why__content reveal">
      <span class="eyebrow">{whyChooseUs.eyebrow}</span>
      <h2>{whyChooseUs.title}</h2>
      {showIntro && <p class="why__intro">{whyChooseUs.intro}</p>}
      <ul class="why__pillars">
        {whyChooseUs.pillars.map((p, i) => (
          <li>
            <span class="why__icon" aria-hidden="true" set:html={icons[i]} />
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .why { position: relative; background: var(--color-secondary); color: #fff; isolation: isolate; overflow: hidden; }
  .why__bg { position: absolute; inset: 0; z-index: -1; background: url("/assets/home/line4.png") center/cover no-repeat; opacity: 0.16; }
  .why__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: stretch; }
  .why__media { min-height: 100%; }
  .why__media img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .why__content { padding: clamp(3rem, 2rem + 5vw, 6rem) clamp(1.5rem, 1rem + 4vw, 5rem); max-width: 720px; }
  .why .eyebrow { color: var(--color-accent); }
  .why h2 { color: #fff; }
  .why__intro { color: rgba(255, 255, 255, 0.88); margin: 1rem 0 1.8rem; max-width: 52ch; }
  .why__pillars { display: flex; flex-direction: column; gap: 1.8rem; }
  .why__pillars li { display: flex; gap: 1.2rem; align-items: flex-start; }
  .why__icon { flex: 0 0 auto; width: 44px; height: 44px; color: #d8d4bf; display: grid; place-items: center; margin-top: 2px; }
  .why__pillars h3 { color: #fff; font-size: 1.2rem; margin-bottom: 0.3rem; }
  .why__pillars p { color: rgba(255, 255, 255, 0.82); font-size: 0.95rem; }
  @media (max-width: 860px) {
    .why__grid { grid-template-columns: 1fr; }
    .why__media { min-height: 340px; max-height: 460px; }
    .why__content { padding: 2.6rem 1.4rem; }
  }
</style>
