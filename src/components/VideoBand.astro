---
export interface Props {
  image?: string;
  eyebrow?: string;
  title?: string;
}
const {
  image = "/assets/home/sunset.webp",
  eyebrow = "Why Balga Designs",
  title = "We Treat Your Garden Like Our Own",
} = Astro.props;
---
<section class="videoband" style={`--vb-img:url('${image}')`}>
  <div class="videoband__overlay" aria-hidden="true"></div>
  <div class="container videoband__inner reveal">
    <button type="button" class="videoband__play" data-video-open aria-label="Play video">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <div class="videoband__text">
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
  </div>
</section>
<style>
  .videoband {
    position: relative;
    background-image: var(--vb-img);
    background-size: cover;
    background-position: center;
    min-height: clamp(360px, 34vw, 520px);
    display: flex;
    align-items: flex-end;
    isolation: isolate;
  }
  .videoband__overlay { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(27,27,27,0.15) 0%, rgba(27,27,27,0.62) 100%); }
  .videoband__inner { width: 100%; padding-block: clamp(2.4rem, 1.5rem + 4vw, 4rem); display: flex; flex-direction: column; align-items: flex-start; gap: 1.2rem; color: #fff; }
  .videoband__play {
    width: 74px; height: 74px; border-radius: 50%;
    background: rgba(255, 255, 255, 0.16); border: 2px solid rgba(255, 255, 255, 0.85); color: #fff;
    display: grid; place-items: center; backdrop-filter: blur(2px);
    transition: background var(--transition), transform var(--transition);
  }
  .videoband__play:hover { background: #fff; color: var(--color-secondary); transform: scale(1.06); }
  .videoband__text .eyebrow { color: var(--color-accent); }
  .videoband__text h2 { color: #fff; max-width: 18ch; }
</style>
