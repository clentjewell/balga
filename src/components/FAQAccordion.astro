---
import { faqs as allFaqs, type FAQ } from "../data/faqs";
export interface Props {
  id?: string;
  title?: string;
  image?: string;
  items?: FAQ[];
  /** Emit FAQPage JSON-LD (keep true on the canonical /faqs/ page only). */
  schema?: boolean;
  /** Optional "see all FAQs" link shown under the list. */
  viewAllHref?: string;
}
const {
  id = "faqs",
  title = "Frequently Asked Questions",
  image,
  items,
  schema = true,
  viewAllHref,
} = Astro.props;
const faqs = items ?? allFaqs;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
  })),
};
---
<section class="section section--white faq" id={id}>
  <div class="container">
    <div class:list={["faq__wrap", { "faq__wrap--split": image }]}>
      <div class="faq__main">
        <div class="faq__head reveal">
          <span class="eyebrow">FAQs</span>
          <h2>{title}</h2>
        </div>
        <div class="faq__list" data-faq>
          {faqs.map((f, i) => (
            <details class="faq__item" open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__body">
                {f.a.map((p) => <p>{p}</p>)}
              </div>
            </details>
          ))}
        </div>
        {viewAllHref && (
          <p class="faq__all"><a href={viewAllHref}>See all frequently asked questions <span aria-hidden="true">&rarr;</span></a></p>
        )}
      </div>
      {image && (
        <div class="faq__media reveal">
          <img src={image} alt="Balga Designs native landscape" width="900" height="1100" loading="lazy" />
        </div>
      )}
    </div>
  </div>
</section>
{schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}

<style>
  .faq__wrap { max-width: calc(var(--container-narrow) + var(--gutter) * 2); margin-inline: auto; }
  .faq__wrap--split { max-width: none; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: center; }
  .faq__head { text-align: center; margin-bottom: 2.5rem; }
  .faq__wrap--split .faq__head { text-align: left; }
  .faq__item { border: 1px solid var(--color-border); border-radius: var(--radius-md); margin-bottom: 0.9rem; background: var(--color-background); overflow: hidden; }
  .faq__item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 1.15rem 1.4rem; cursor: pointer; font-weight: 600; color: var(--color-primary);
    font-family: var(--font-heading); list-style: none;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; flex: 0 0 auto; width: 18px; height: 18px; }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; background: var(--color-secondary); transition: transform var(--transition); }
  .faq__icon::before { top: 8px; left: 0; width: 18px; height: 2px; }
  .faq__icon::after { left: 8px; top: 0; width: 2px; height: 18px; }
  .faq__item[open] .faq__icon::after { transform: scaleY(0); }
  .faq__body { padding: 0 1.4rem 1.3rem; }
  .faq__body p { color: var(--color-text); }
  .faq__body p + p { margin-top: 0.8rem; }
  .faq__all { margin-top: 1.6rem; text-align: center; }
  .faq__wrap--split .faq__all { text-align: left; }
  .faq__all a { color: var(--color-secondary); font-weight: 600; }
  .faq__media img { width: 100%; height: 100%; max-height: 520px; object-fit: cover; border-radius: var(--radius-md); }
  @media (max-width: 860px) {
    .faq__wrap--split { grid-template-columns: 1fr; }
    .faq__wrap--split .faq__media { order: -1; }
    .faq__media img { max-height: 320px; }
  }
</style>

<script>
  const wrap = document.querySelector("[data-faq]");
  if (wrap) {
    const items = Array.from(wrap.querySelectorAll<HTMLDetailsElement>("details"));
    items.forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) items.forEach((o) => { if (o !== d) o.open = false; });
      });
    });
  }
</script>
