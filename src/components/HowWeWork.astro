---
import { howWeWork } from "../data/content";
const icons = ["/assets/icons/icon2.png", "/assets/icons/icon4.png", "/assets/icons/icon7.png"];
const arrows = ["/assets/icons/arrow-4.png", "/assets/icons/arrow-5.png"];

export interface Props {
  /** "band" — one filled panel (home page). "cards" — outlined cards (about page). */
  variant?: "band" | "cards";
}
const { variant = "band" } = Astro.props;
---
<section class="section section--white hww">
  <div class="container">
    <span class="eyebrow hww__eyebrow">{howWeWork.eyebrow}</span>
    <div class:list={["hww__box", `hww__box--${variant}`, "reveal"]}>
      {howWeWork.steps.map((s, i) => (
        <>
          <div class="hww__step">
            <div class="hww__icon"><img src={icons[i]} alt="" width="72" height="72" loading="lazy" /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
          {i < howWeWork.steps.length - 1 && (
            <div class="hww__arrow" aria-hidden="true"><img src={arrows[i]} alt="" width="90" height="40" loading="lazy" /></div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
<style>
  .hww__eyebrow { display: block; text-align: center; margin-bottom: 2rem; }

  .hww__box {
    display: grid;
    grid-template-columns: 1fr 0.8fr 1fr 0.8fr 1fr;
    align-items: stretch;
  }
  .hww__step { text-align: center; padding: clamp(2rem, 1.2rem + 2vw, 3.2rem) clamp(1rem, 0.5rem + 1.5vw, 2rem); }
  .hww__icon { margin: 0 auto 1.4rem; display: grid; place-items: center; }
  .hww__icon img { width: 72px; height: 72px; object-fit: contain; }
  .hww__step h3 { margin-bottom: 0.9rem; font-size: 1.45rem; }
  .hww__step p { color: var(--color-text); max-width: 22ch; margin-inline: auto; font-size: 0.98rem; line-height: 1.9; }
  .hww__arrow { display: grid; place-items: center; }
  .hww__arrow img { width: 90px; height: auto; opacity: 0.75; }

  /* Home: one continuous panel, columns separated by hairlines. */
  .hww__box--band { background: var(--color-panel); }
  .hww__box--band > * + * { box-shadow: inset 1px 0 0 rgba(90, 103, 78, 0.09); }

  /* About: the steps sit in outlined cards, the arrows in the space between. */
  .hww__box--cards .hww__step { border: 1px solid var(--color-border-light); background: var(--color-white); }

  @media (max-width: 860px) {
    .hww__box { grid-template-columns: 1fr; }
    .hww__arrow { display: none; }
    .hww__box--band > * + * { box-shadow: inset 0 1px 0 rgba(90, 103, 78, 0.09); }
    .hww__box--cards .hww__step + .hww__step { margin-top: 1.2rem; }
  }
</style>
