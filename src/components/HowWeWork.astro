---
import { howWeWork } from "../data/content";
const icons = ["/assets/icons/icon2.png", "/assets/icons/icon4.png", "/assets/icons/icon7.png"];
const arrows = ["/assets/icons/arrow-4.png", "/assets/icons/arrow-5.png"];
---
<section class="section section--white hww">
  <div class="container">
    <div class="hww__box reveal">
      {howWeWork.steps.map((s, i) => (
        <>
          <div class="hww__step">
            <div class="hww__icon"><img src={icons[i]} alt="" width="72" height="72" loading="lazy" /></div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </div>
          {i < howWeWork.steps.length - 1 && (
            <div class="hww__arrow" aria-hidden="true"><img src={arrows[i]} alt="" width="90" height="40" loading="lazy" /></div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
<style>
  .hww__box {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
  }
  .hww__step { text-align: center; padding: 0 0.5rem; }
  .hww__icon { width: 104px; height: 104px; margin: 0 auto 1.2rem; display: grid; place-items: center; background: var(--color-background); border-radius: 50%; box-shadow: var(--shadow-soft); }
  .hww__icon img { width: 56px; height: 56px; object-fit: contain; }
  .hww__step h3 { margin-bottom: 0.5rem; }
  .hww__step p { color: var(--color-secondary-dark); max-width: 30ch; margin-inline: auto; font-size: 0.95rem; }
  .hww__arrow { display: grid; place-items: center; padding-top: 34px; }
  .hww__arrow img { width: 90px; height: auto; opacity: 0.7; }
  @media (max-width: 860px) {
    .hww__box { grid-template-columns: 1fr; gap: 2.2rem; }
    .hww__arrow { display: none; }
  }
</style>
