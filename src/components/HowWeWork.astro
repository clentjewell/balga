---
import { howWeWork } from "../data/content";
const icons = ["/assets/icons/icon2.png", "/assets/icons/icon4.png", "/assets/icons/icon7.png"];
---
<section class="section hww section--mint">
  <div class="container">
    <div class="hww__head reveal">
      <span class="eyebrow">{howWeWork.eyebrow}</span>
      <h2>From Vision to Living Landscape</h2>
    </div>
    <ol class="hww__grid">
      {howWeWork.steps.map((s, i) => (
        <li class="hww__step reveal">
          <div class="hww__icon"><img src={icons[i]} alt="" width="72" height="72" loading="lazy" /></div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .hww { text-align: center; }
  .hww__head { margin-bottom: 3rem; }
  .hww__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; counter-reset: step; }
  .hww__step { position: relative; padding: 0 1rem; }
  .hww__icon { width: 108px; height: 108px; margin: 0 auto 1.3rem; display: grid; place-items: center; background: var(--color-background); border-radius: 50%; box-shadow: var(--shadow-soft); }
  .hww__icon img { width: 60px; height: 60px; object-fit: contain; }
  .hww__step h3 { margin-bottom: 0.6rem; }
  .hww__step p { color: var(--color-text); max-width: 34ch; margin-inline: auto; }
  @media (max-width: 860px) { .hww__grid { grid-template-columns: 1fr; gap: 2.6rem; } }
</style>
