---
import BeforeAfterSlider from "./BeforeAfterSlider.astro";
import { projectsPreview } from "../data/projects";
export interface Props { eyebrow?: string; }
const { eyebrow = "Our Projects" } = Astro.props;
---
<section class="section section--mint projects-preview">
  <div class="container">
    <div class="pp__head reveal">
      <span class="eyebrow">{eyebrow}</span>
      <h2>Come Home to Paradise</h2>
      <p class="lead mx-auto">Discover the beauty of sustainable garden design. From urban retreats to sprawling natural landscapes, we’ve had the privilege of transforming gardens of all shapes and sizes.</p>
    </div>
    <div class="pp__grid">
      {projectsPreview.map((p) => (
        <div class="pp__item reveal">
          <BeforeAfterSlider before={p.before} after={p.after} beforeAlt={p.beforeAlt} afterAlt={p.afterAlt} />
        </div>
      ))}
    </div>
    <div class="pp__cta">
      <a href="/projects/" class="btn btn--primary">All Projects</a>
    </div>
  </div>
</section>
<style>
  .pp__head { text-align: center; max-width: 60ch; margin: 0 auto 2.8rem; }
  .pp__head .lead { margin-top: 1rem; }
  .pp__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .pp__cta { text-align: center; margin-top: 2.6rem; }
  @media (max-width: 900px) { .pp__grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
