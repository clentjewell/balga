---
import { testimonials as all } from "../data/testimonials";
import { altFor } from "../data/media";
// Section heading, intro and backdrop are client-editable (CMS "Shared sections").
import sections from "../data/content/sections.json";
export interface Props { count?: number; }
const { count = all.length } = Astro.props;
const items = all.slice(0, count);
const stars = [0, 1, 2, 3, 4];
---
<section class="testi">
  <div class="testi__media">
    <img src={sections.testimonialsImage} alt={altFor(sections.testimonialsImage)} width="900" height="1100" loading="lazy" />
  </div>
  <div class="testi__panel">
    <div class="testi__inner">
      <div class="testi__head reveal">
        <span class="eyebrow">{sections.testimonialsEyebrow}</span>
        <h2>{sections.testimonialsTitle}</h2>
        <p class="testi__intro">{sections.testimonialsIntro}</p>
      </div>

      <div class="testi__slider" data-testi>
        <ul class="testi__track" data-testi-track>
          {items.map((t) => (
            <li class="testi__slide">
              <div class="testi__card">
                <div class="testi__stars" aria-label="5 out of 5 stars">
                  {stars.map(() => (
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.6 1.4 6.8L12 17.8 5.9 20.4l1.4-6.8L2.2 9l6.9-.7L12 2z"/></svg>
                  ))}
                </div>
                <blockquote>{t.quote}</blockquote>
                <div class="testi__author">
                  <span class="testi__name">{t.author}</span>
                  {t.role && <span class="testi__role">{t.role}</span>}
                </div>
                <span class="testi__mark" aria-hidden="true">
                  <svg viewBox="0 0 512 512" fill="currentColor" width="80" height="80"><path d="M464 32H336c-26.5 0-48 21.5-48 48v128c0 26.5 21.5 48 48 48h80v64c0 35.3-28.7 64-64 64h-8c-13.3 0-24 10.7-24 24v48c0 13.3 10.7 24 24 24h8c88.4 0 160-71.6 160-160V80c0-26.5-21.5-48-48-48zm-288 0H48C21.5 32 0 53.5 0 80v128c0 26.5 21.5 48 48 48h80v64c0 35.3-28.7 64-64 64h-8c-13.3 0-24 10.7-24 24v48c0 13.3 10.7 24 24 24h8c88.4 0 160-71.6 160-160V80c0-26.5-21.5-48-48-48z"/></svg>
                </span>
              </div>
            </li>
          ))}
        </ul>
        <div class="testi__controls">
          <div class="testi__nav">
            <button type="button" aria-label="Previous testimonial" data-testi-prev>‹</button>
            <button type="button" aria-label="Next testimonial" data-testi-next>›</button>
          </div>
          <div class="testi__dots" data-testi-dots>
            {items.map((_, i) => (
              <button type="button" aria-label={`Go to testimonial ${i + 1}`} data-dot={i}></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .testi { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: stretch; }
  .testi__media { min-height: 100%; }
  .testi__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .testi__panel { position: relative; background: var(--color-accent); color: var(--color-primary); display: flex; align-items: center; min-width: 0; overflow: hidden; }
  .testi__panel::before { content: ""; position: absolute; inset: 0; background: url("/assets/home/line4.png") center/cover no-repeat; opacity: 0.18; mix-blend-mode: multiply; pointer-events: none; }
  .testi__inner { position: relative; z-index: 1; width: 100%; min-width: 0; max-width: 680px; margin: 0 auto; padding: clamp(2.6rem, 1.5rem + 5vw, 5rem) clamp(1.5rem, 1rem + 3vw, 3.5rem); }
  .testi__slider { min-width: 0; }
  .testi__head { margin-bottom: 2rem; }
  .testi__head .eyebrow { color: var(--color-secondary); }
  .testi__head h2 { color: var(--color-primary); }
  .testi__intro { color: var(--color-secondary-dark); margin-top: 1rem; }

  .testi__track { display: flex; overflow-x: auto; min-width: 0; scroll-snap-type: x mandatory; scroll-behavior: smooth; scrollbar-width: none; -ms-overflow-style: none; }
  .testi__track::-webkit-scrollbar { display: none; }
  .testi__slide { flex: 0 0 100%; scroll-snap-align: start; padding: 0.4rem; }
  .testi__card { position: relative; background: var(--color-background); color: var(--color-secondary-dark); border-radius: var(--radius-md); padding: 2rem 2rem 1.6rem; overflow: hidden; }
  .testi__stars { display: flex; gap: 3px; color: #d9a441; margin-bottom: 1rem; }
  .testi__card blockquote {
    line-height: 1.75; font-size: 0.95rem; position: relative; z-index: 1;
    display: -webkit-box; -webkit-line-clamp: 10; line-clamp: 10; -webkit-box-orient: vertical; overflow: hidden;
  }
  .testi__author { margin-top: 1.2rem; position: relative; z-index: 1; }
  .testi__name { display: block; font-family: var(--font-heading); font-weight: 600; color: var(--color-secondary); }
  .testi__role { display: block; font-size: 0.85rem; color: var(--color-text); }
  .testi__mark { position: absolute; right: 1.3rem; bottom: 1rem; line-height: 0; color: rgba(90, 103, 78, 0.14); z-index: 0; }
  .testi__mark svg { width: 72px; height: 72px; display: block; }

  .testi__controls { display: flex; align-items: center; gap: 1.2rem; margin-top: 1.6rem; }
  .testi__dots { display: flex; gap: 0.25rem; margin-left: auto; }
  .testi__dots button { width: 28px; height: 28px; border-radius: 50%; background: transparent; display: grid; place-items: center; }
  .testi__dots button::before { content: ""; width: 9px; height: 9px; border-radius: 50%; background: rgba(27, 27, 27, 0.25); transition: background var(--transition); }
  .testi__dots button[aria-current="true"]::before { background: var(--color-secondary); }
  .testi__nav { display: flex; gap: 0.5rem; }
  .testi__nav button { width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(27, 27, 27, 0.35); color: var(--color-secondary-dark); font-size: 1.4rem; line-height: 1; display: grid; place-items: center; transition: background var(--transition); }
  .testi__nav button:hover { background: rgba(27, 27, 27, 0.08); }

  @media (max-width: 860px) {
    .testi { grid-template-columns: 1fr; }
    .testi__media { min-height: 240px; max-height: 300px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-testi]").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-testi-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dotsWrap = root.querySelector<HTMLElement>("[data-testi-dots]")!;
    const prev = root.querySelector<HTMLButtonElement>("[data-testi-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-testi-next]")!;

    const dots = Array.from(dotsWrap.querySelectorAll<HTMLButtonElement>("button"));
    dots.forEach((b, i) => {
      b.addEventListener("click", () => track.scrollTo({ left: track.clientWidth * i, behavior: "smooth" }));
    });
    const update = () => {
      const idx = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((d, i) => {
        if (i === idx) d.setAttribute("aria-current", "true");
        else d.removeAttribute("aria-current");
      });
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -track.clientWidth, behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: track.clientWidth, behavior: "smooth" }));
    track.addEventListener("scroll", () => requestAnimationFrame(update));
    window.addEventListener("resize", update);
    update();

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce) {
      let timer = setInterval(auto, 6000);
      function auto() {
        const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 8;
        if (atEnd) track.scrollTo({ left: 0, behavior: "smooth" });
        else track.scrollBy({ left: track.clientWidth, behavior: "smooth" });
      }
      root.addEventListener("pointerenter", () => clearInterval(timer));
      root.addEventListener("pointerleave", () => { timer = setInterval(auto, 6000); });
    }
  });
</script>
