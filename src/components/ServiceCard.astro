---
import type { Service } from "../data/services";
export interface Props { service: Service; }
const { service } = Astro.props;
---
<article class="svc-card reveal">
  <a class="svc-card__link" href={`/services/${service.slug}/`} aria-label={`${service.title} — learn more`}>
    <div class="svc-card__media">
      <img src={service.image} alt={service.alt} width={service.width} height={service.height} loading="lazy" />
    </div>
    <div class="svc-card__body">
      <h3>{service.title}</h3>
      <p>{service.description}</p>
      <span class="svc-card__more">Learn more <span aria-hidden="true">&rarr;</span></span>
    </div>
  </a>
</article>
<style>
  .svc-card {
    background: var(--color-accent); /* #B7B597 */
    border-radius: var(--radius-md);
    padding: 14px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: background var(--transition);
  }
  .svc-card:hover { background: var(--color-sand); /* #DAD3BE */ }
  .svc-card__link { display: flex; flex-direction: column; height: 100%; color: inherit; }
  .svc-card__link:focus-visible { outline: 3px solid var(--color-secondary); outline-offset: 3px; border-radius: var(--radius-md); }
  .svc-card__media { aspect-ratio: 16 / 11; overflow: hidden; border-radius: var(--radius-md); }
  .svc-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .svc-card:hover .svc-card__media img { transform: scale(1.04); }
  .svc-card__body { padding: 1.2rem 0.6rem 0.6rem; display: flex; flex-direction: column; flex: 1; }
  .svc-card__body h3 { color: var(--color-primary); margin-bottom: 0.6rem; }
  .svc-card__body p { color: #34402f; }
  .svc-card__more { margin-top: auto; padding-top: 0.9rem; font-weight: 600; color: var(--color-secondary); font-size: 0.95rem; }
</style>
