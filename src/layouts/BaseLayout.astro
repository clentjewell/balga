---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/utilities.css";
import "../styles/components.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  bodyClass?: string;
  preloadImage?: string;
}

const {
  title,
  description = "Balga Designs creates beautiful native landscapes with a regenerative perspective — sustainable garden design across the Northern Rivers to Southern Gold Coast.",
  ogImage = "/assets/branding/og-image.jpg",
  canonical,
  bodyClass = "",
  preloadImage,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? "http://localhost").toString();
const ogImageUrl = ogImage.startsWith("http") ? ogImage : siteUrl + ogImage;
// Preview clone: block indexing unless explicitly disabled.
const noindex = (import.meta.env.PUBLIC_NOINDEX ?? "true") !== "false";
const fullTitle = title.includes("Balga Designs") ? title : `${title} – Balga Designs`;
const metaDescription = description;

// Sitewide structured data: LocalBusiness + WebSite (linked via @id).
const schemaGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `${siteUrl}/#business`,
      name: site.name,
      alternateName: site.brandLine,
      description:
        "Sustainable landscape and native garden design studio serving the Northern Rivers to the Southern Gold Coast.",
      url: `${siteUrl}/`,
      logo: `${siteUrl}${site.logos.mark}`,
      image: `${siteUrl}/assets/projects/project-02/after.jpeg`,
      telephone: site.contact.phoneE164,
      email: site.contact.email,
      priceRange: "$$",
      slogan: site.slogan,
      address: {
        "@type": "PostalAddress",
        addressLocality: site.contact.addressLocality,
        addressRegion: site.contact.addressRegion,
        postalCode: site.contact.postalCode,
        addressCountry: site.contact.addressCountry,
      },
      geo: { "@type": "GeoCoordinates", latitude: site.contact.geo.latitude, longitude: site.contact.geo.longitude },
      areaServed: site.contact.serviceAreas.map((n) => ({ "@type": "Place", name: n })),
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: site.contact.openingHours.days,
          opens: site.contact.openingHours.opens,
          closes: site.contact.openingHours.closes,
        },
      ],
      sameAs: [site.social.facebook, site.social.instagram, site.social.google],
      knowsAbout: [
        "Native gardens", "Sustainable landscape design", "Regenerative planting",
        "Horticulture", "Water-wise gardens", "Landscape architecture",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: "Balga Designs",
      description: metaDescription,
      inLanguage: "en-AU",
      publisher: { "@id": `${siteUrl}/#business` },
    },
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="author" content="Balga Designs" />

    <!-- Local / geo signals -->
    <meta name="geo.region" content="AU-NSW" />
    <meta name="geo.placename" content="Lennox Head" />
    <meta name="geo.position" content="-28.7876;153.5942" />
    <meta name="ICBM" content="-28.7876, 153.5942" />

    <link rel="preconnect" href="/" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preload" href="/fonts/montserrat-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/branding/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/branding/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/assets/branding/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Balga Designs" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content="Balga Designs native landscape" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Balga Designs native landscape" />
    <meta name="theme-color" content="#5a674e" />

    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} is:inline />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll (respects prefers-reduced-motion via CSS gating)
      const els = document.querySelectorAll(".reveal");
      if ("IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
        // Failsafe: never leave content hidden if the observer doesn't fire.
        setTimeout(() => els.forEach((el) => el.classList.add("is-visible")), 3000);
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
