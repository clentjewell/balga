---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import VideoBand from "../components/VideoBand.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import VideoModal from "../components/VideoModal.astro";
import { projects } from "../data/projects";
import { faqsByCategory } from "../data/faqs";
import page from "../data/content/projects.json";
---
<BaseLayout title="Garden Projects & Transformations" description="Explore Balga Designs before-and-after garden transformations across the Northern Rivers — sustainable, contemporary native landscaping built to thrive." preloadImage={page.heroImage}>
  <PageHero title={page.heroTitle} image={page.heroImage} crumbs={[{ label: "Home", href: "/" }, { label: "Projects" }]} />

  <section class="section section--mint">
    <div class="container">
      <div class="proj-head reveal">
        <span class="eyebrow">{page.headEyebrow}</span>
        <h2>{page.headTitle}</h2>
      </div>
      <div class="proj-grid">
        {projects.map((p, i) => (
          <div class:list={["proj-item reveal", { "proj-item--wide": i === projects.length - 1 }]}>
            <BeforeAfterSlider
              before={p.before}
              after={p.after}
              beforeAlt={p.beforeAlt}
              afterAlt={p.afterAlt}
              ratio={i === projects.length - 1 ? "16 / 8" : "4 / 3"}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <VideoBand />

  <FAQAccordion id="faqs" title={page.faqTitle} items={faqsByCategory(["Timing & process", "Service area"])} schema={false} viewAllHref="/faqs/" />
  <VideoModal />
</BaseLayout>

<style>
  .proj-head { text-align: center; margin-bottom: 3rem; }
  .proj-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.8rem; }
  .proj-item--wide { grid-column: 1 / -1; }
  @media (max-width: 760px) { .proj-grid { grid-template-columns: 1fr; } }
</style>
