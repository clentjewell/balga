---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import BeforeAfterSlider from "../components/BeforeAfterSlider.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.description);
const gallery = projects.filter((p) => !p.description);
---
<BaseLayout title="Projects" description="Explore Balga Designs before-and-after transformations across the Northern Rivers — sustainable, contemporary native landscaping.">
  <PageHero title="Projects" image="/assets/projects/project-01/after.jpg" crumbs={[{ label: "Home", href: "/" }, { label: "Projects" }]} />

  <section class="section section--white">
    <div class="container">
      <div class="proj-head reveal">
        <span class="eyebrow">How we work</span>
        <h2>Come Home to Paradise</h2>
      </div>

      {featured.map((p, i) => (
        <article class:list={["proj-row reveal", { "proj-row--rev": i % 2 === 1 }]}>
          <div class="proj-row__text">
            <h3>{p.title}</h3>
            <ul class="proj-meta">
              {p.location && <li><strong>Location:</strong> {p.location}</li>}
              {p.service && <li><strong>Service:</strong> {p.service}</li>}
              {p.date && <li><strong>Date:</strong> {p.date}</li>}
            </ul>
            {p.description && <p>{p.description}</p>}
          </div>
          <div class="proj-row__media">
            <BeforeAfterSlider before={p.before} after={p.after} beforeAlt={p.beforeAlt} afterAlt={p.afterAlt} ratio="16 / 10" />
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--mint">
    <div class="container">
      <div class="proj-head reveal">
        <span class="eyebrow">Transformations</span>
        <h2>Before &amp; After Gallery</h2>
      </div>
      <div class="proj-gallery">
        {gallery.map((p) => (
          <figure class="proj-card reveal">
            <BeforeAfterSlider before={p.before} after={p.after} beforeAlt={p.beforeAlt} afterAlt={p.afterAlt} ratio="4 / 3" />
            <figcaption>{p.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <WhyChooseUs showIntro={false} />
  <FAQAccordion id="faqs" title="FAQs" />
  <CTASection title="Beautiful Landscapes Start Here" image="/assets/projects/project-07/after.jpg" />
</BaseLayout>

<style>
  .proj-head { text-align: center; margin-bottom: 3rem; }
  .proj-row { display: grid; grid-template-columns: 1fr 1.15fr; gap: 2.5rem; align-items: center; margin-bottom: 3.5rem; }
  .proj-row--rev .proj-row__text { order: 2; }
  .proj-row__text h3 { margin-bottom: 1rem; }
  .proj-meta { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1.2rem; color: var(--color-text); }
  .proj-meta strong { color: var(--color-primary); }
  .proj-row__text p { color: var(--color-text); }
  .proj-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.8rem; }
  .proj-card figcaption { margin-top: 0.9rem; font-family: var(--font-heading); font-weight: 600; color: var(--color-primary); }
  @media (max-width: 860px) {
    .proj-row { grid-template-columns: 1fr; gap: 1.4rem; }
    .proj-row--rev .proj-row__text { order: 0; }
    .proj-gallery { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; }
  }
</style>
