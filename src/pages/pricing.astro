---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";
import { packages } from "../data/pricing";
---
<BaseLayout title="Pricing" description="Four Balga Designs packages — Small NativeScapes, Potted Greenery, Balga Inspo and the Complete Design Package — with transparent pricing.">
  <PageHero title="Pricing Plans" image="/assets/pricing/package-4.jpg" crumbs={[{ label: "Home", href: "/" }, { label: "Pricing" }]} />

  <section class="section section--white">
    <div class="container">
      <div class="price-head reveal">
        <span class="eyebrow">Pricing</span>
        <h2>Choose Your Plan</h2>
      </div>

      <div class="price-list">
        {packages.map((p, i) => (
          <article class:list={["price-card reveal", { "price-card--rev": i % 2 === 1 }]}>
            <div class="price-card__media">
              <img src={p.image} alt={p.alt} width="717" height="512" loading="lazy" />
            </div>
            <div class="price-card__body">
              <h3>{p.title}</h3>
              <p class="price-card__sub">{p.subtitle}</p>
              <p class="price-card__meta">{p.hours}</p>
              <div class="price-card__price">
                <span class="price-card__amount">{p.price}</span>
                <span class="price-card__radius">{p.radius}</span>
              </div>
              <div class="stack price-card__intro">
                {p.intro.map((t) => <p>{t}</p>)}
              </div>
              <p class="price-card__inc-label">{p.includedIntro}</p>
              <ul class="price-card__included">
                {p.included.map((li) => <li>{li}</li>)}
              </ul>
              {p.notes.length > 0 && (
                <div class="price-card__notes">
                  {p.notes.map((n) => <p>{n}</p>)}
                </div>
              )}
              <a href="/contact/" class="btn btn--primary">Get Started</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <WhyChooseUs showIntro={false} />
  <TestimonialSlider count={5} />
  <FAQAccordion id="faqs" title="Frequently Asked Questions" />
  <CTASection title="Beautiful Landscapes Start Here" image="/assets/pricing/package-1.jpg" />
</BaseLayout>

<style>
  .price-head { text-align: center; margin-bottom: 3rem; }
  .price-list { display: flex; flex-direction: column; gap: 2.5rem; }
  .price-card {
    display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 0;
    background: var(--color-background); border: 1px solid var(--color-border);
    border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-soft);
  }
  .price-card--rev .price-card__media { order: 2; }
  .price-card__media { min-height: 100%; }
  .price-card__media img { width: 100%; height: 100%; object-fit: cover; min-height: 260px; }
  .price-card__body { padding: 2.2rem clamp(1.5rem, 1rem + 2vw, 2.6rem); }
  .price-card__body h3 { margin-bottom: 0.4rem; }
  .price-card__sub { color: var(--color-accent); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.85rem; margin-bottom: 0.8rem; }
  .price-card__meta { color: var(--color-text); font-size: 0.9rem; }
  .price-card__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin: 0.8rem 0 1.2rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--color-border); }
  .price-card__amount { font-family: var(--font-heading); font-weight: 700; font-size: 2rem; color: var(--color-secondary); }
  .price-card__radius { color: var(--color-text); font-size: 0.88rem; }
  .price-card__intro p { color: var(--color-text); }
  .price-card__inc-label { font-weight: 600; color: var(--color-primary); margin: 1.2rem 0 0.7rem; }
  .price-card__included { display: flex; flex-direction: column; gap: 0.55rem; margin-bottom: 1.2rem; }
  .price-card__included li { position: relative; padding-left: 1.6rem; color: var(--color-text); }
  .price-card__included li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--color-secondary); font-weight: 700; }
  .price-card__notes { margin-bottom: 1.4rem; }
  .price-card__notes p { font-size: 0.82rem; color: var(--color-muted); font-style: italic; }
  .price-card__notes p + p { margin-top: 0.4rem; }
  @media (max-width: 860px) {
    .price-card { grid-template-columns: 1fr; }
    .price-card--rev .price-card__media { order: 0; }
  }
</style>
