---
import BaseLayout from "../layouts/BaseLayout.astro";
import { altFor } from "../data/media";
import PageHero from "../components/PageHero.astro";
import VideoBand from "../components/VideoBand.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import CTASection from "../components/CTASection.astro";
import VideoModal from "../components/VideoModal.astro";
import { packages } from "../data/pricing";
import { faqsByCategory } from "../data/faqs";
import page from "../data/content/pricing.json";
import { jsonLd } from "../data/html";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const priceNum = (s: string) => s.replace(/[^0-9.]/g, "");
const offerSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  name: "Balga Designs Garden Design Packages",
  url: `${siteUrl}/pricing/`,
  itemListElement: packages.map((p) => ({
    "@type": "Offer",
    name: p.title,
    description: p.subtitle,
    price: priceNum(p.price),
    priceCurrency: "AUD",
    availability: "https://schema.org/InStock",
    url: `${siteUrl}/pricing/`,
    itemOffered: { "@type": "Service", name: p.title, description: p.subtitle, provider: { "@id": `${siteUrl}/#business` } },
  })),
};
---
<BaseLayout title="Garden Design Pricing & Packages" description="Transparent pricing from Balga Designs — four native garden design packages, from Small NativeScapes to the Complete Design Package. Find your plan." preloadImage={page.heroImage}>
  <PageHero title={page.heroTitle} image={page.heroImage} crumbs={[{ label: "Home", href: "/" }, { label: "Pricing" }]} />
  <script type="application/ld+json" set:html={jsonLd(offerSchema)} is:inline />

  <section class="section section--white">
    <div class="container">
      <div class="price-head reveal">
        <span class="eyebrow">{page.headEyebrow}</span>
        <h2>{page.headTitle}</h2>
      </div>

      <div class="price-grid">
        {packages.map((p, i) => (
          <article class:list={["price-card reveal", { "price-card--alt": i === 1 || i === 2 }]}>
            <h3 class="price-card__title">{p.title}</h3>
            <p class="price-card__hours">({p.hours})</p>
            <p class="price-card__sub">{p.subtitle}</p>
            <p class="price-card__amount">{p.price}</p>
            <div class="price-card__media">
              <img src={p.image} alt={altFor(p.image, p.alt)} width="717" height="512" loading="lazy" />
            </div>
            <p class="price-card__radius">{p.radius}</p>
            <div class="stack price-card__intro">
              {p.intro.map((t) => <p>{t}</p>)}
            </div>
            <p class="price-card__inc-label">{p.includedIntro}</p>
            <ul class="price-card__included">
              {p.included.map((li) => <li>{li}</li>)}
            </ul>
            {p.notes.length > 0 && (
              <div class="price-card__notes">
                {p.notes.map((n) => <p>{n}</p>)}
              </div>
            )}
            <a href="/contact/" class="btn btn--primary price-card__btn">Get Started</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <VideoBand />
  <TestimonialSlider count={5} />
  <FAQAccordion id="faqs" title={page.faqTitle} image={page.faqImage} items={faqsByCategory(["Cost & packages", "Payment"])} schema={false} viewAllHref="/faqs/" />
  <CTASection image={page.ctaImage} />
  <VideoModal />
</BaseLayout>

<style>
  .price-head { text-align: center; margin-bottom: 3rem; }
  .price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; grid-auto-rows: 1fr; }
  .price-card {
    background: var(--color-mint);
    border-radius: var(--radius-md);
    padding: clamp(1.6rem, 1rem + 1.6vw, 2.4rem);
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .price-card--alt { background: var(--color-accent); }
  .price-card__title { font-size: 1.35rem; margin-bottom: 0.3rem; }
  .price-card__hours { font-size: 0.85rem; color: var(--color-text); margin-bottom: 0.9rem; }
  .price-card__sub { font-weight: 600; color: var(--color-secondary); margin-bottom: 0.6rem; }
  .price-card__amount { font-family: var(--font-heading); font-weight: 700; font-size: 1.8rem; color: var(--color-primary); margin-bottom: 1.2rem; }
  .price-card__media { border-radius: var(--radius-md); overflow: hidden; margin-bottom: 1.2rem; aspect-ratio: 717 / 512; }
  .price-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .price-card__radius { color: var(--color-text); font-size: 0.9rem; margin-bottom: 1rem; }
  .price-card__intro p { color: var(--color-text); font-size: 0.95rem; }
  .price-card__inc-label { font-weight: 600; color: var(--color-primary); margin: 1.2rem 0 0.7rem; }
  .price-card__included { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.2rem; }
  .price-card__included li { position: relative; padding-left: 1.5rem; color: var(--color-text); font-size: 0.92rem; }
  .price-card__included li::before { content: "✓"; position: absolute; left: 0; top: 0; color: var(--color-secondary); font-weight: 700; }
  .price-card__notes { margin-bottom: 1.4rem; }
  .price-card__notes p { font-size: 0.8rem; color: var(--color-muted); font-style: italic; }
  .price-card__notes p + p { margin-top: 0.4rem; }
  .price-card__btn { align-self: flex-start; margin-top: auto; }
  @media (max-width: 820px) { .price-grid { grid-template-columns: 1fr; max-width: 560px; margin-inline: auto; } }
</style>
