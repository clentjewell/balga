---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ProjectsPreview from "../components/ProjectsPreview.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import { services } from "../data/services";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Landscape and native garden design",
  provider: { "@id": `${siteUrl}/#business` },
  areaServed: "Northern Rivers NSW to Southern Gold Coast QLD",
  url: `${siteUrl}/services/`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Garden & Landscaping Services",
    itemListElement: services.map((s) => ({
      "@type": "Offer",
      itemOffered: { "@type": "Service", name: s.title, description: s.description },
    })),
  },
};
---
<BaseLayout title="Garden & Landscaping Services" description="Total care for your garden: native landscape design, garden facelifts, planting, pest and weed management and horticulture advice across the Northern Rivers." preloadImage="/assets/services/hero.webp">
  <PageHero title="Services" image="/assets/services/hero.webp" crumbs={[{ label: "Home", href: "/" }, { label: "Services" }]} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />

  <section class="section section--white">
    <div class="container">
      <div class="svc-head reveal">
        <span class="eyebrow">Our Services</span>
        <h2>Total Care For Your Garden</h2>
      </div>
      <div class="svc-grid">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <ProjectsPreview />
  <WhyChooseUs />
  <TestimonialSlider count={6} />
</BaseLayout>

<style>
  .svc-head { text-align: center; margin-bottom: 3rem; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  @media (max-width: 900px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .svc-grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; } }
</style>
