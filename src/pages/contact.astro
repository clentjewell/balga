---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";

const info = [
  { label: "Address", value: site.contact.address, icon: "📍" },
  { label: "Email", value: site.contact.email, href: `mailto:${site.contact.email}`, icon: "✉️" },
  { label: "Service Area", value: "Serving Northern Rivers to Southern Gold Coast", icon: "🌿" },
  { label: "Phone", value: site.contact.phone, href: site.contact.phoneHref, icon: "📞" },
  { label: "Available Hours", value: "07:00 AM - 04:00 PM", icon: "🕐" },
];
---
<BaseLayout title="Contact" description="Contact Balga Designs to start your journey towards a more beautiful, sustainable garden across the Northern Rivers to Southern Gold Coast.">
  <PageHero title="Contact Us" image="/assets/home/hero/balga-designs-garden.jpeg" crumbs={[{ label: "Home", href: "/" }, { label: "Contact" }]} />

  <section class="section section--white">
    <div class="container">
      <div class="contact-intro reveal">
        <span class="eyebrow">Our Contact</span>
        <h2>Let's Bring Your Vision to Life</h2>
        <p>Ready to transform your outdoor space?</p>
        <p>Contact Balga Designs today to start your journey towards a more beautiful, sustainable garden.</p>
      </div>

      <div class="contact-grid">
        <div class="contact-info reveal">
          <ul>
            {info.map((c) => (
              <li>
                <span class="contact-info__icon" aria-hidden="true">{c.icon}</span>
                <div>
                  <h3>{c.label}</h3>
                  {c.href ? <a href={c.href}>{c.value}</a> : <p>{c.value}</p>}
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="contact-form-wrap reveal">
          <h3>Send us a message</h3>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .contact-intro { text-align: center; max-width: 60ch; margin: 0 auto 3rem; }
  .contact-intro p { color: var(--color-text); }
  .contact-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 3rem; align-items: start; }
  .contact-info ul { display: flex; flex-direction: column; gap: 1.4rem; }
  .contact-info li { display: flex; gap: 1rem; align-items: flex-start; }
  .contact-info__icon { flex: 0 0 auto; width: 48px; height: 48px; display: grid; place-items: center; background: var(--color-mint); border-radius: 50%; font-size: 1.2rem; }
  .contact-info h3 { font-size: 1.05rem; margin-bottom: 0.2rem; }
  .contact-info p, .contact-info a { color: var(--color-text); }
  .contact-info a:hover { color: var(--color-secondary); }
  .contact-form-wrap { background: var(--color-mint); border-radius: var(--radius-md); padding: clamp(1.6rem, 1rem + 2vw, 2.4rem); }
  .contact-form-wrap h3 { margin-bottom: 1.4rem; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; gap: 2.2rem; } }
</style>
