---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import HowWeWork from "../components/HowWeWork.astro";
import ProjectsPreview from "../components/ProjectsPreview.astro";
import CTASection from "../components/CTASection.astro";
import VideoModal from "../components/VideoModal.astro";
import { services } from "../data/services";
import { heroFeatures } from "../data/content";
import home from "../data/content/home.json";
---
<BaseLayout
  title="Balga Designs | Native & Sustainable Garden Design"
  description="Balga Designs creates beautiful, regenerative native gardens from the Northern Rivers to the Southern Gold Coast — sustainable design that works with nature."
  preloadImage={home.heroImage1}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__slideshow" aria-hidden="true">
      <div class="hero__slide" style={`--img:url('${home.heroImage1}')`}></div>
      <div class="hero__slide" data-hero-img={`url('${home.heroImage2}')`}></div>
      <div class="hero__slide" data-hero-img={`url('${home.heroImage3}')`}></div>
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__content">
        <span class="eyebrow">{home.heroEyebrow}</span>
        <h1>{home.heroHeading}</h1>
        <p class="hero__sub">{home.heroSub}</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--outline-light">Start Your Project</a>
        </div>
      </div>
      <div class="hero__aside">
        <button type="button" class="hero__play" data-video-open aria-label="Play video">
          <span class="hero__play-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>
          <span>Play Video</span>
        </button>
      </div>
    </div>
  </section>

  <!-- FEATURE PAIR -->
  <section class="section--mint feature-pair">
    <div class="container">
      <ul class="feature-pair__grid">
        {heroFeatures.map((f) => (
          <li class="feature-pair__card reveal">
            <img src={f.icon} alt="" width="96" height="96" loading="lazy" />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section section--white home-about">
    <div class="container">
      <div class="home-about__inner reveal">
        <span class="eyebrow">About Us</span>
        <h2>{home.aboutHeading}</h2>
        <div class="home-about__text stack">
          <p>{home.aboutPara1}</p>
          <p>{home.aboutPara2}</p>
        </div>
        <a href="/about/" class="btn btn--primary home-about__btn">Read More</a>
      </div>
      <div class="home-about__imgs reveal">
        <img src={home.aboutImage1} alt={home.aboutImage1Alt} width="1000" height="750" loading="lazy" />
        <img src={home.aboutImage2} alt={home.aboutImage2Alt} width="1000" height="750" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section section--white home-services">
    <div class="container">
      <div class="home-services__head reveal">
        <span class="eyebrow">Our Services</span>
        <h2>Total Care For Your Garden</h2>
      </div>
      <div class="home-services__grid">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <WhyChooseUs />
  <HowWeWork />
  <ProjectsPreview />
  <CTASection />
  <VideoModal />
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: var(--color-hero);
    color: #fff;
    padding-top: 120px;
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__slideshow { position: absolute; inset: 0; z-index: -2; }
  .hero__slide {
    position: absolute; inset: 0;
    background-image: var(--img);
    background-size: cover;
    background-position: center;
    opacity: 0;
    animation: heroFade 18s infinite;
  }
  .hero__slide:nth-child(1) { animation-delay: 0s; }
  .hero__slide:nth-child(2) { animation-delay: 6s; }
  .hero__slide:nth-child(3) { animation-delay: 12s; }
  @keyframes heroFade {
    0%   { opacity: 0; }
    3%   { opacity: 1; }
    30%  { opacity: 1; }
    36%  { opacity: 0; }
    100% { opacity: 0; }
  }
  .hero__overlay {
    position: absolute; inset: 0; z-index: -1;
    background: rgba(90, 103, 78, 0.6); /* #5A674E @ 0.6 */
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__slide { animation: none; opacity: 0; }
    .hero__slide:nth-child(1) { opacity: 1; }
  }
  .hero__inner { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: 2rem; min-height: 300px; }
  .hero__content { max-width: 720px; }
  .hero .eyebrow { color: var(--color-accent); }
  .hero h1 { color: var(--color-white); margin-bottom: 1.3rem; }
  .hero__sub { color: rgba(255, 255, 255, 0.92); max-width: 46ch; margin-bottom: 2rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .hero__aside { display: flex; justify-content: center; }
  .hero__play {
    display: inline-flex; align-items: center; gap: 0.8rem;
    background: #fff; color: var(--color-secondary);
    padding: 10px 22px 10px 12px; border-radius: var(--radius-pill); font-weight: 600;
    box-shadow: var(--shadow-soft); transition: transform var(--transition);
  }
  .hero__play:hover { transform: translateY(-2px); }
  .hero__play-icon { width: 40px; height: 40px; border-radius: 50%; background: var(--color-secondary); color: #fff; display: grid; place-items: center; }

  .feature-pair { padding-block: clamp(2.5rem, 1.5rem + 4vw, 4rem); }
  .feature-pair__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .feature-pair__card { background: transparent; border: 1px solid rgba(255, 255, 255, 0.85); border-radius: var(--radius-md); padding: 2.8rem 2rem; text-align: center; transition: background var(--transition), box-shadow var(--transition); }
  .feature-pair__card:hover { background: #fff; box-shadow: var(--shadow-soft); }
  .feature-pair__card img { width: 120px; height: 120px; object-fit: contain; margin: 0 auto 1.2rem; }
  .feature-pair__card h3 { margin-bottom: 0.5rem; }
  .feature-pair__card p { color: var(--color-text); }

  .home-about__inner { max-width: 900px; }
  .home-about__text { margin-top: 0.6rem; }
  .home-about__text p { max-width: 74ch; }
  .home-about__btn { margin-top: 1.8rem; }
  .home-about__imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 3rem; }
  .home-about__imgs img { width: 100%; height: clamp(420px, 44vw, 640px); object-fit: cover; border-radius: var(--radius-md); }
  @media (max-width: 760px) { .home-about__imgs { grid-template-columns: 1fr; } }

  .home-services__head { text-align: center; margin-bottom: 3rem; }
  .home-services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__aside { justify-content: flex-start; }
    .feature-pair__grid { grid-template-columns: 1fr; }
    .home-services__grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
  @media (min-width: 640px) and (max-width: 900px) {
    .home-services__grid { grid-template-columns: 1fr 1fr; max-width: none; }
  }
</style>

<script>
  // Defer hero slides 2–3 until after load so they don't compete with the LCP image.
  const hydrateHero = () => {
    document.querySelectorAll<HTMLElement>(".hero__slide[data-hero-img]").forEach((el) => {
      el.style.setProperty("--img", el.dataset.heroImg!);
      el.removeAttribute("data-hero-img");
    });
  };
  if (document.readyState === "complete") hydrateHero();
  else window.addEventListener("load", hydrateHero);
</script>
