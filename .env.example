# Contact form email delivery (Cloudflare Worker /api/contact).
# Set these as Wrangler secrets in production — never commit real values.
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put CONTACT_TO_EMAIL
#   npx wrangler secret put CONTACT_FROM_EMAIL
# If any are missing, the form runs in preview mode (validates but does not send).
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@balgadesigns.com.au
CONTACT_FROM_EMAIL=website@your-verified-domain

# Build-time site origin (canonicals, sitemap, og:url, llms.txt). Defaults to the
# live domain — only set this when building a preview or staging clone.
SITE_URL=https://balgadesigns.com.au
# Hide a preview clone from search engines. Leave unset for the live site; pair it
# with the Worker var PREVIEW_NOINDEX="true" in wrangler.jsonc.
# PUBLIC_NOINDEX=true
