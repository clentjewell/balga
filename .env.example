# Contact form email delivery (Cloudflare Worker /api/contact).
# Set these as Wrangler secrets in production — never commit real values.
#   npx wrangler secret put RESEND_API_KEY
#   npx wrangler secret put CONTACT_TO_EMAIL
#   npx wrangler secret put CONTACT_FROM_EMAIL
# If any are missing, the form runs in preview mode (validates but does not send).
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@balgadesigns.com.au
CONTACT_FROM_EMAIL=website@your-verified-domain

# Build-time site origin (used for canonicals + sitemap).
SITE_URL=https://balga-designs-preview.workers.dev
