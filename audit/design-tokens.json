{
  "source": "https://balgadesigns.com.au/ (computed styles + Elementor global palette)",
  "font": {
    "family": "Montserrat, sans-serif",
    "source": "self-hosted (WordPress /wp-content/uploads/elementor/google-fonts) — Google Fonts Montserrat",
    "weights": [400, 500, 600, 700],
    "loadedWeights": [100, 200, 300, 400, 500, 600, 700, 800, 900]
  },
  "color": {
    "primary": "#1B1B1B",
    "secondary": "#5A674E",
    "text": "#6B847A",
    "accent": "#B7B597",
    "mint": "#DDEBEA",
    "sand": "#DAD3BE",
    "hero": "#939B8A",
    "white": "#FEFEFC",
    "background": "#FFFDFB",
    "footer": "#5A674E",
    "card": "#A7A489",
    "border": "rgba(90,103,78,0.18)",
    "elementorPalette": {
      "primary": "#1B1B1B",
      "secondary": "#5A674E",
      "text": "#6B847A",
      "accent": "#B7B597",
      "custom-3278aa1": "#DDEBEA",
      "custom-6c27a88": "#FEFEFC",
      "custom-fbf4eb9": "#DAD3BE"
    }
  },
  "typography": {
    "body":        { "family": "Montserrat", "size": "16px", "weight": 400, "lineHeight": "28.8px", "color": "#6B847A" },
    "h1":          { "size": "70px", "weight": 600, "lineHeight": "84px", "color": "#FEFEFC", "note": "hero, white over green" },
    "h2":          { "size": "47px", "weight": 600, "lineHeight": "61.1px", "color": "#1B1B1B" },
    "h3":          { "size": "25px", "weight": 600, "lineHeight": "32.5px", "color": "#1B1B1B" },
    "h4":          { "size": "21px", "weight": 600, "lineHeight": "27.3px" },
    "eyebrow":     { "size": "16px", "weight": 600, "letterSpacing": "5px", "textTransform": "uppercase", "color": "#B7B597" },
    "navLink":     { "size": "16px", "weight": 400, "color": "#5A674E" },
    "button":      { "size": "16px", "weight": 500, "padding": "15px 20px", "borderRadius": "0px" },
    "footerHeading": { "size": "21px", "weight": 600, "color": "#FFFFFF" },
    "footerText":  { "size": "16px", "weight": 400, "lineHeight": "28.8px", "color": "#6B847A" }
  },
  "layout": {
    "containerWidth": "1140px",
    "breakpoints": { "mobile": "767px", "tablet": "1024px", "desktop": "1140px" },
    "bodyBackground": "#FFFDFB"
  },
  "radii": { "button": "0px", "pill": "999px (Contact Us / hero buttons)", "card": "0px", "image": "0px" },
  "buttons": {
    "primaryPill": { "shape": "pill (border-radius 999px)", "style": "outline white on hero / solid on light sections" },
    "contactUs":   { "shape": "pill outline", "color": "white text + light border" }
  },
  "effects": {
    "entrance": "Elementor fadeInUp / fadeIn on headings & nav (respect prefers-reduced-motion)",
    "counters": "count-up on scroll into view",
    "testimonials": "swiper autoplay carousel, 1 per view",
    "faq": "accordion (one open)",
    "beforeAfter": "draggable divider, initial 50%"
  }
}
